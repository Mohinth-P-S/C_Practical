#include <iostream>
using namespace std;
class Student
{
    private:
        int rollNo;
        string name;
    public:
        Student(int r, string n)
        {
            rollNo = r;
            name = n;
            cout << "Student object created" << endl;
        }
        void display()
        {
            cout << "Roll Number: " << rollNo << endl;
            cout << "Name: " << name << endl;
        }
        ~Student()
        {
            cout << "Student object destroyed" << endl;
        }
};
int main()
{
    int rollNo;
    cout << "Enter Roll Number: ";
    cin >> rollNo;
    string name;
    cout << "Enter Name: ";
    cin >> name;
    Student s1(rollNo, name);
    s1.display();
    return 0;
}